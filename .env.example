# ---------------------------------------------------------------------------
# Menu reading. Without a key the app still runs, but scans show a clearly
# labelled sample menu instead of your photo.
# ---------------------------------------------------------------------------

# Free: an OpenRouter key (https://openrouter.ai/keys). Uses free models only,
# so nothing is billed. Limit: about 50 menu pages a day for the whole app.
OPENROUTER_API_KEY=""

# Optional. Default "openrouter/free" picks any free model that can read
# photos. To pin one, use a model ID that ends in ":free".
OPENROUTER_MODEL=""

# Recommended. A code your friends type once before their first scan, so
# strangers who find the URL can't use up your daily free reads.
INVITE_CODE=""

# Optional, paid instead of free: a Claude key (https://console.anthropic.com).
# Used only when OPENROUTER_API_KEY is empty.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# Optional. "true" = the server returns fixture menus with no API calls.
AI_MOCK=""
