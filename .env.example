# ---------------------------------------------------------------------------
# Menu reading (Claude). Without a key the app still runs, but scans show a
# clearly labelled sample menu instead of your photo.
# Get a key at https://console.anthropic.com → API keys.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# Optional. Default: claude-sonnet-5-5. claude-haiku-5-5 is cheaper and faster.
ANTHROPIC_MODEL=""

# Recommended. A code your friends type once before their first scan, so
# strangers who find the URL can't spend your AI credits. Leave blank = open.
INVITE_CODE=""

# Optional. "true" = the server returns fixture menus with no API calls.
AI_MOCK=""
